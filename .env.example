# お問い合わせフォームのメール送信に必要な環境変数（値はダミー）。
# 実値は .env.local に記載（Gitには載せない）。本番は各ホスティングの
# 環境変数に同じキーを設定してください。

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_FROM=Retouch お問い合わせ <your-account@gmail.com>
CONTACT_TO=your-account@gmail.com

# Supabase（管理画面 /admin 用）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# 管理画面ログイン（npm run seed:admin で Supabase Auth に登録）
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=your-secure-password
